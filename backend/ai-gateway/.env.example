# 与自建 Supabase docker/.env 中的 JWT_SECRET 相同
SUPABASE_JWT_SECRET=
# LLM：DeepSeek（json_object 降级方案，用户已确认）
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=7000
LIMIT_PARSE_PER_DAY=60
LIMIT_SUMMARY_PER_DAY=3
# 讯飞语音听写（流式版）：本机识别不可用时的联网兜底；三项缺一则 /diary-asr 返回 503
XFYUN_APPID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
LIMIT_ASR_PER_DAY=60
