<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1 桌面小部件（设计稿 17B）：主要计时 + 结束/开始喂奶 + 换尿布 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/hh_widget_bg" android:padding="8dp">
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/head_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/hh_avatar_baby" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#3D3A45" android:maxLines="1" />
        <Chronometer android:id="@+id/chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/hh_pill" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#E0673F" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/btn_main" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:background="@drawable/hh_btn" android:textSize="12sp" android:textColor="#3D3A45" android:maxLines="1" />
        <TextView android:id="@+id/btn_diaper" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/hh_btn" android:text="换尿布"
            android:textSize="12sp" android:textColor="#3D3A45" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
